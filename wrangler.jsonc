{
  "name": "la-pizarra",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/logo/*", "/api/*"]
  },
  "routes": [
    { "pattern": "lapizarra.wheelos.es", "custom_domain": true }
  ],
  // Cada hora: el Worker decide que toca segun la hora de Madrid (push a las
  // 07:00, resumen por correo a la hora que elige cada persona en Ajustes).
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "SUPABASE_URL": "https://ejtzoeaqwjktllqvhfsv.supabase.co",
    "APP_URL": "https://lapizarra.wheelos.es",
    "MAIL_FROM": "avisos@wheelos.es",
    "VAPID_PUBLIC_KEY": "BNloHmI2v6RQofJq3sQiKU2tGhnyEIsORRLOiXQOjIZEVZNBnVqtgPw2zv3u-kyu26St37aNWZP94-N647dsxlo"
  }
}
